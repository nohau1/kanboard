# Database
DB_HOST=localhost
DB_USER=kanban
DB_PASSWORD=change-me
DB_NAME=kanban

# JWT secret (required) - generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-key

# Default admin password (used only on first run)
ADMIN_PASSWORD=admin123

# Server
PORT=3001

# Frontend (optional) - API base URL.
# Leave empty when frontend and API are served from the same origin (nginx).
# VITE_API_URL=https://api.your-domain.com
